# krabink.darksailor.dev: the default relay and the web app on one origin,
# so browsers reach the relay without CORS or mixed content.
#
#   krabink-server --config /etc/krabink/server.toml
#
# with, in server.toml (plain HTTP behind this proxy; Caddy owns TLS):
#
#   [relay]
#   http_listen = "127.0.0.1:3340"
#   public_url  = "https://krabink.darksailor.dev"
#   access      = "open"
#   [replica]
#   enable = false
#
# and the web app from `cargo make web-build` copied to /srv/krabink-web.

krabink.darksailor.dev {
	encode zstd gzip

	# The relay: websocket upgrade on /relay, latency probes on /ping.
	@relay path /relay /ping /generate_204
	handle @relay {
		reverse_proxy 127.0.0.1:3340
	}

	handle {
		root * /srv/krabink-web
		try_files {path} /index.html
		file_server
		header /*.wasm Cache-Control "public, max-age=31536000, immutable"
		header /*.js Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}
}
